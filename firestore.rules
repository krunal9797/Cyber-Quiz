rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Administrators registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Students directory
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidId(studentId) &&
        incoming().studentId is string &&
        incoming().studentId.size() <= 64 &&
        incoming().fullName is string &&
        incoming().passcode is string;
      allow delete: if isValidId(studentId);
    }

    // Quiz configs per day
    match /quiz_configs/{configId} {
      allow read, write: if true;
    }

    // Master Questions Bank
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(questionId);
    }

    // Student Quiz Attempts
    match /quiz_attempts/{attemptId} {
      allow read, write: if true;
    }

    // Final assessment results
    match /final_results/{studentId} {
      allow read, write: if true;
    }
  }
}
